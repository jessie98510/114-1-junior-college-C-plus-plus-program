#include <iostream>
#include <iomanip>
using namespace std;

#define SIZE 20  

int main() {
    int n[SIZE];

    cout << "請輸入 " << SIZE << " 份問卷的分數：" << endl;
    for (int i = 0; i < SIZE; i++) {
        cin >> n[i];
    }

    cout << setw(7) << "Element"
        << setw(13) << "Value"
        << setw(17) << "Histogram" << endl;

    for (int i = 0; i < SIZE; i++) {
        cout << setw(7) << i
            << setw(13) << n[i]
            << "        ";

        for (int j = 0; j < n[i]; j++) {
            cout << "*";
        }

        cout << endl;
    }

    return 0;
}
