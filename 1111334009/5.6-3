1.
#ifndef MATRIX_H
#define MATRIX_H

#include <iostream>
using namespace std;

class Matrix
{
public:
    int row, column;
    int** element;

    Matrix(int m, int n);
    Matrix(char name, int m, int n);
    ~Matrix();

    Matrix operator-(int x);  
};

#endif

2.
#include "Matrix.h"

Matrix::Matrix(int m, int n)
{
    row = m;
    column = n;

    element = new int* [row];
    for (int i = 0; i < row; i++)
        element[i] = new int[column];
}

Matrix::Matrix(char name, int m, int n)
{
    row = m;
    column = n;

    element = new int* [row];
    for (int i = 0; i < row; i++)
        element[i] = new int[column];

    cout << "輸入 " << name << " 矩陣 (" << m << "x" << n << ")\n";
    for (int i = 0; i < row; i++)
        for (int j = 0; j < column; j++)
        {
            cout << name << "[" << i << "][" << j << "] = ";
            cin >> element[i][j];
        }
}

Matrix::~Matrix()
{
    for (int i = 0; i < row; i++)
        delete[] element[i];
    delete[] element;
}

Matrix Matrix::operator-(int x)
{
    Matrix temp(row, column);

    for (int i = 0; i < row; i++)
        for (int j = 0; j < column; j++)
            temp.element[i][j] = element[i][j] - x;

    return temp;
}

3.
#include <iostream>
#include "Matrix.h"
using namespace std;

int main()
{
    int row, column, num;

    cout << "矩陣 - 整數 (a - b)\n";
    cout << "輸入矩陣列數(row): ";
    cin >> row;
    cout << "輸入矩陣行數(column): ";
    cin >> column;

    Matrix a('A', row, column);
    Matrix b(row, column);

    cout << "\n輸入要減的整數 b: ";
    cin >> num;

    b = a - num;

    cout << "\n原始矩陣 A:\n";
    for (int i = 0; i < row; i++)
    {
        for (int j = 0; j < column; j++)
            cout << a.element[i][j] << "\t";
        cout << endl;
    }

    cout << "\nA - " << num << " 結果:\n";
    for (int i = 0; i < row; i++)
    {
        for (int j = 0; j < column; j++)
            cout << b.element[i][j] << "\t";
        cout << endl;
    }

    return 0;
}
