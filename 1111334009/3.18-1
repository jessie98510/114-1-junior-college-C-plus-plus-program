#include <iostream>
using namespace std;

template <typename T>
T volume(T a, T b, T c)
{
    return a * b * c;
}

int main()
{
    int int1, int2, int3;

    cout << "請輸入三個整數：";
    cin >> int1 >> int2 >> int3;

    cout << "整數體積為："
        << volume(int1, int2, int3);

    float float1, float2, float3;

    cout << "\n\n請輸入三個浮點數：";
    cin >> float1 >> float2 >> float3;

    cout << "浮點數體積為："
        << volume(float1, float2, float3);

    double double1, double2, double3;

    cout << "\n\n請輸入三個 double 數值：";
    cin >> double1 >> double2 >> double3;

    cout << "double 體積為："
        << volume(double1, double2, double3) << endl;

    return 0;
}
