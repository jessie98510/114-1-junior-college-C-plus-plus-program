#include <iostream>
using namespace std;

class DateInterface {
public:
    virtual void input() = 0;
    virtual bool isValid() = 0;
    virtual void printAD() = 0;
    virtual void printROC() = 0;
};
class Date : public DateInterface {
private:
    int year, month, day;

public:
    Date(int y = 1990, int m = 1, int d = 1) {
        year = y;
        month = m;
        day = d;
    }

    void input() override {
        cout << "請輸入西元 年 月 日：";
        cin >> year >> month >> day;
    }

    bool isLeap(int y) {
        return (y % 4 == 0 && y % 100 != 0) || (y % 400 == 0);
    }

    bool isValid() override {
        if (month < 1 || month > 12)
            return false;

        int daysInMonth[] = { 31,28,31,30,31,30,31,31,30,31,30,31 };

        if (isLeap(year))
            daysInMonth[1] = 29;

        if (day < 1 || day > daysInMonth[month - 1])
            return false;

        return true;
    }

    void printAD() override {
        cout << "西元日期: "
            << year << "/"
            << month << "/"
            << day << endl;
    }
    void printROC() override {
        int rocYear = year - 1911;

        if (rocYear <= 0) {
            cout << "此日期尚未進入民國年" << endl;
        }
        else {
            cout << "民國日期: "
                << rocYear << "/"
                << month << "/"
                << day << endl;
        }
    }
};

int main() {
    Date d;  

    d.input();

    if (!d.isValid()) {
        cout << "錯誤：日期不合法！" << endl;
    }
    else {
        d.printAD();
        d.printROC();
    }

    return 0;
}
