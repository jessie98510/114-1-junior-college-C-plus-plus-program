1.
#ifndef TIME_H
#define TIME_H

#include <iostream>

class Time
{
	friend std::ostream& operator<<(std::ostream&, const Time&);

public:
	Time(int h = 0, int m = 0, int s = 0);

	void setTime(int, int, int);

	Time& operator++();      
	Time operator++(int);  

	Time& operator+=(unsigned int);

private:
	unsigned int hour;
	unsigned int minute;
	unsigned int second;

	void helpIncrement();
};

#endif
________________________________________________________________________________________________________________________________________________________
2.
#include <iostream>
#include <iomanip>
#include <stdexcept>
#include "Time.h"

using namespace std;

Time::Time(int h, int m, int s)
{
    setTime(h, m, s);
}

void Time::setTime(int h, int m, int s)
{
    if (h >= 0 && h <= 23)
        hour = h;
    else
        throw invalid_argument("Hour must be between 0 and 23");

    if (m >= 0 && m <= 59)
        minute = m;
    else
        throw invalid_argument("Minute must be between 0 and 59");

    if (s >= 0 && s <= 59)
        second = s;
    else
        throw invalid_argument("Second must be between 0 and 59");
}

Time& Time::operator++()
{
    helpIncrement();
    return *this;
}

Time Time::operator++(int)
{
    Time temp = *this;

    helpIncrement();

    return temp;
}

Time& Time::operator+=(unsigned int additionalSeconds)
{
    for (unsigned int i = 0; i < additionalSeconds; ++i)
        helpIncrement();

    return *this;
}

void Time::helpIncrement()
{
    ++second;

    if (second >= 60)
    {
        second = 0;
        ++minute;
    }

    if (minute >= 60)
    {
        minute = 0;
        ++hour;
    }

    if (hour >= 24)
    {
        hour = 0;
    }
}

ostream& operator<<(ostream& output, const Time& t)
{
    output << setfill('0')
        << setw(2) << t.hour << ":"
        << setw(2) << t.minute << ":"
        << setw(2) << t.second;

    return output;
}
________________________________________________________________________________________________________________________________________________________
3.
#include <iostream>
#include "Time.h"

using namespace std;

int main()
{
    try
    {
        Time time1(8, 24, 36);
        Time time2;

        cout << "time1 is " << time1 << endl;
        cout << "time2 is " << time2 << endl;

        cout << "\ntime1 += 30" << endl;
        cout << "Result: " << (time1 += 30) << endl;

        cout << "\nTesting prefix ++" << endl;
        cout << "++time1 = " << ++time1 << endl;
        cout << "time1   = " << time1 << endl;

        cout << "\nTesting postfix ++" << endl;
        cout << "time1++ = " << time1++ << endl;
        cout << "time1   = " << time1 << endl;

        Time time3(23, 59, 58);

        cout << "\nRollover test" << endl;
        cout << "time3 = " << time3 << endl;

        ++time3;
        cout << "++time3 = " << time3 << endl;

        ++time3;
        cout << "++time3 = " << time3 << endl;

        Time errorTime(25, 70, 80);
    }
    catch (invalid_argument& e)
    {
        cout << "\nException: " << e.what() << endl;
    }

    return 0;
}
