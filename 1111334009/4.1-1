#include <iostream>
using namespace std;

class Pet {
private:
    string name; 
    int age;     

public:
    Pet(string n, int a) {
        name = n;
        age = a;
        cout << "寵物 " << name << " 已被建立！" << endl;
    }

    void showInfo() {
        cout << "寵物姓名: " << name << ", 年齡: " << age << endl;
    }

    ~Pet() {
        cout << "與寵物 " << name << " 說再見！" << endl;
    }
};

int main() {
    Pet pet1("萌萌", 3);
    Pet pet2("黑黑", 5);

    pet1.showInfo();
    pet2.showInfo();

    return 0;
}
