#include <iostream>
using namespace std;

long long fact(int n) {
    if (n == 0 || n == 1)
        return 1;
    return n * fact(n - 1);
}

int main() {
    int n;
    cout << "輸入項數 n: ";
    cin >> n;

    double e = 1.0; 

    for (int i = 1; i <= n; i++) {
        e += 1.0 / fact(i);
    }

    cout << "e 的近似值 = " << e << endl;
    return 0;
}
