#include <iostream>
#include <fstream>
#include <cstring>
using namespace std;

struct student {
    int id;
    char name[20];
    int computer;
    int math;
    double avg;
};

int main() {

    fstream file("students.dat", ios::out | ios::binary);

    if (!file) {
        cout << "檔案無法開啟！" << endl;
        return 1;
    }

    student blankStudent;

    blankStudent.id = 0;
    strcpy(blankStudent.name, "");
    blankStudent.computer = 0;
    blankStudent.math = 0;
    blankStudent.avg = 0.0;

    for (int i = 0; i < 100; i++) {
        file.write(reinterpret_cast<char*>(&blankStudent), sizeof(student));
    }

    file.close();

    cout << "已成功建立 100 筆空白學生資料的隨機存取檔 students.dat" << endl;

    return 0;
}
