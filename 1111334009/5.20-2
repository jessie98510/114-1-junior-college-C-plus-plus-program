#include <iostream>
#include <string>

using namespace std;

// -------------------- student 類別 --------------------
class student
{
protected:
    string student_id;
    string student_name;

public:
    student(string id, string name)
    {
        student_id = id;
        student_name = name;
    }
};

// -------------------- teacher 類別 --------------------
class teacher
{
protected:
    string teacher_id;
    string teacher_name;

    string course_id;
    string course_name;
    int course_credit;

public:
    teacher(string id, string name)
    {
        teacher_id = id;
        teacher_name = name;
    }

    void data_input()
    {
        cout << "請輸入課程編號：";
        cin >> course_id;

        cin.ignore();

        cout << "請輸入課程名稱：";
        getline(cin, course_name);

        cout << "請輸入課程學分：";
        cin >> course_credit;
    }
};

// -------------------- classroom 類別 --------------------
class classroom : public teacher, public student
{
public:
    classroom(
        string t_id,
        string t_name,
        string s_id,
        string s_name
    )
        : teacher(t_id, t_name),
        student(s_id, s_name)
    {
    }

    void show()
    {
        cout << "\n===== classroom 資料 =====" << endl;

        cout << "課程編號：" << course_id << endl;
        cout << "課程名稱：" << course_name << endl;
        cout << "課程學分：" << course_credit << endl;

        cout << "教師姓名：" << teacher_name << endl;
        cout << "學生姓名：" << student_name << endl;
    }
};

// -------------------- main --------------------
int main()
{
    string t_id, t_name;
    string s_id, s_name;

    cout << "請輸入教師編號：";
    cin >> t_id;

    cin.ignore();

    cout << "請輸入教師姓名：";
    getline(cin, t_name);

    cout << "請輸入學生編號：";
    cin >> s_id;

    cin.ignore();

    cout << "請輸入學生姓名：";
    getline(cin, s_name);

    classroom c(t_id, t_name, s_id, s_name);

    c.data_input();

    c.show();

    return 0;
}
