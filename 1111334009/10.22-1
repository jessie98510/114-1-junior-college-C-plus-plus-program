#include <iostream>
#include <iomanip> 
using namespace std;

int main() {

    double principal; 
    double rate;      
    double target;   
    double currentAmount;
    int years = 0;     

    cout << "請輸入本金 (例如 10000): ";
    cin >> principal;

    cout << "請輸入年利率 (例如 0.05 表示 5%): ";
    cin >> rate;

    cout << "請輸入存款目標: ";
    cin >> target;

    currentAmount = principal;
    cout << fixed << setprecision(2);

    cout << "--------------------------------" << endl;
    cout << "第 " << years << " 年 (初始本金): " << currentAmount << endl;

    while (currentAmount < target) {
        years++;

        currentAmount = currentAmount * (1.0 + rate);

        cout << "第 " << years << " 年底本利合: " << currentAmount << endl;
    }
    cout << "--------------------------------" << endl;
    cout << "恭喜！總共花了 " << years << " 年達成或超過存款目標。" << endl;

    return 0;
}
