#include <iostream>
#include <cmath>    
#include <iomanip> 
using namespace std;
double approximate_pi(int n) {
    int i;
    double pi_approx = 0.0;
    double sign = 1.0;

    for (i = 0; i < n; i++) {
        double denominator = 2.0 * i + 1.0;
        pi_approx += sign * (4.0 / denominator);
        sign *= -1.0;
    }
    return pi_approx;
}
double calculate_circle_circumference(double pi, double r) {
    return 2.0 * pi * r;
}
double calculate_circle_area(double pi, double r) {
    return pi * r * r;
}
double calculate_sphere_volume(double pi, double r) {
    return (4.0 / 3.0) * pi * pow(r, 3);
}
double calculate_sphere_surface_area(double pi, double r) {
    return 4.0 * pi * r * r;
}
double calculate_cylinder_volume(double pi, double r, double h) {
    return pi * r * r * h;
}
double calculate_cylinder_surface_area(double pi, double r, double h) {
    double side_area = 2.0 * pi * r * h;
    double base_area = 2.0 * pi * r * r;
    return side_area + base_area;
}
int main() {
    int n;      
    double r, h; 

    cout << fixed << setprecision(10);

    cout << "請輸入計算 Pi 的疊代次數 (n): ";
    cin >> n;

    cout << "請輸入半徑 (r): ";
    cin >> r;

    cout << "請輸入圓柱體的高度 (h): ";
    cin >> h;

    cout << "----------------------------------------" << endl;

    double my_pi = approximate_pi(n);
    cout << "Pi 的近似值 (n=" << n << "): " << my_pi << endl;

    cout << "----------------------------------------" << endl;
    cout << "使用 r = " << r << " 和 h = " << h << " 進行計算:" << endl << endl;

    double circ_circumference = calculate_circle_circumference(my_pi, r);
    cout << "1. 圓周長:" << circ_circumference << endl;

    double circ_area = calculate_circle_area(my_pi, r);
    cout << "2. 圓面積:" << circ_area << endl;

    double sphere_vol = calculate_sphere_volume(my_pi, r);
    cout << "3. 球體積:" << sphere_vol << endl;

    double sphere_area = calculate_sphere_surface_area(my_pi, r);
    cout << "4. 球表面積:" << sphere_area << endl;

    double cyl_vol = calculate_cylinder_volume(my_pi, r, h);
    cout << "5. 圓柱體積:" << cyl_vol << endl;

    double cyl_area = calculate_cylinder_surface_area(my_pi, r, h);
    cout << "6. 圓柱表面積:" << cyl_area << endl;

    return 0;
}


